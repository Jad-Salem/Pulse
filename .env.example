# Copy to .env to override the development defaults baked into docker-compose.yml.
# Every value below is the default; none of them is a production secret.

# Credentials
CLICKHOUSE_ADMIN_USER=pulse_admin
CLICKHOUSE_ADMIN_PASSWORD=pulse-admin-dev
CLICKHOUSE_QUERY_API_PASSWORD=query-api-dev
CLICKHOUSE_GRAFANA_PASSWORD=grafana-dev
GRAFANA_ADMIN_PASSWORD=admin
# Comma-separated write keys accepted by the collector (X-API-Key header)
COLLECTOR_API_KEYS=dev-write-key
LOADGEN_API_KEY=dev-write-key

# Stream processing
PULSE_SESSION_GAP_SECONDS=120
PULSE_VELOCITY_THRESHOLD=3
PULSE_VELOCITY_WINDOW_SECONDS=60
FLINK_CHECKPOINT_INTERVAL=10s

# Simulated traffic
LOADGEN_USERS=60
LOADGEN_FRAUD_USERS=1
