          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT minute AS time, sum(revenue_cents) / 100 AS revenue FROM pulse.metrics_minute WHERE $__timeFilter(minute) GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1"
