    {
      "id": 5,
      "type": "stat",
      "title": "Session conversion",
      "description": "Sessions with a purchase / all sessions with any event in the range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT if(all_sessions = 0, 0, converted / all_sessions) AS conversion FROM (SELECT uniqMerge(sessions) AS all_sessions FROM pulse.metrics_minute WHERE $__timeFilter(minute)) AS a CROSS JOIN (SELECT uniqMerge(sessions) AS converted FROM pulse.metrics_minute WHERE $__timeFilter(minute) AND event_type = 'purchase') AS b",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {},
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pipeline latency (p95)",
      "description": "Collector accept -> queryable in ClickHouse, including the exactly-once checkpoint commit.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT quantile(0.95)(dateDiff('millisecond', received_at, ingested_at)) / 1000 AS p95 FROM pulse.events WHERE $__timeFilter_ms(ingested_at)",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {},
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
