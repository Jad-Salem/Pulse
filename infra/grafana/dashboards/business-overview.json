    {
      "id": 9,
      "type": "bargauge",
      "title": "Purchase funnel (sessions)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT countIf(level >= 1) AS `1. viewed product`, countIf(level >= 2) AS `2. added to cart`, countIf(level >= 3) AS `3. started checkout`, countIf(level >= 4) AS `4. purchased` FROM (SELECT session_id, windowFunnel(3600)(toDateTime(event_time), event_type = 'product_view', event_type = 'add_to_cart', event_type = 'checkout_started', event_type = 'purchase') AS level FROM pulse.events FINAL WHERE $__timeFilter_ms(event_time) GROUP BY session_id)",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
