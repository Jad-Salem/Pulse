      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT any(product_name) AS product, any(product_category) AS category, sum(quantity) AS units, uniqExact(order_id) AS orders, sum(revenue_cents) / 100 AS revenue FROM pulse.events FINAL WHERE event_type = 'purchase' AND $__timeFilter_ms(event_time) GROUP BY product_id ORDER BY revenue DESC LIMIT 10",
